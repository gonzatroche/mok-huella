# Supabase — apuntar a tu proyecto local (supabase start) o a uno en la nube.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic — extracción de facturas con IA (server-only, NUNCA con prefijo NEXT_PUBLIC).
# Sin esta clave, el botón "Extraer datos" de Evidencias devuelve 503.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
